+import { signingDocuments } from '../data.js';
+import { state, currentUser, getUser, getDispute, loginAs, loginFormer, persistData, addAudit, addNotification, formatDate, formatDateTime, escapeHTML, titleCase } from '../store.js';
+import { icon, badge, notice, toast } from '../ui.js';
+
+function documentsFor(dispute, type) {
+  if (!dispute) return [];
+  return type === 'agreement' ? [...(dispute.agreements || []), ...(dispute.agreement ? [dispute.agreement] : [])] : [...(dispute.waivers || []), ...(dispute.waiver ? [dispute.waiver] : [])];
+}
+function locate(pathType, id, params) {
+  const type = ['waivers', 'waiver'].includes(pathType) ? 'waiver' : 'agreement';
+  let dispute = null; let documentId = null;
+  if (pathType === 'disputes') {
+    dispute = getDispute(id);
+    documentId = params.get('document') || dispute?.agreements?.at(-1)?.id || dispute?.agreement?.id;
+  } else {
+    documentId = id;
+    dispute = state.data.disputes.find(item => documentsFor(item, type).some(document => document.id === id));
+  }
+  const document = documentsFor(dispute, type).find(item => item.id === documentId);
+  if (!document || !dispute) return null;
+  const staticDocument = signingDocuments[`${type}:${documentId}`] || null;
+  const signatures = dispute.signatures.filter(signature => signature.documentType === type && signature.documentId === documentId);
+  return { type, dispute, document, staticDocument, signatures };
+}
+function header() {
+  return `<header class="signing-header"><a class="access-brand" href="/" aria-label="MAHI homepage"><span class="brand-mark">M/</span><span class="brand-copy"><strong>MAHI TECH GROUP</strong><span>DOCUMENT REVIEW</span></span></a><span class="prototype-badge">Frontend-only demonstration</span><span class="signing-header__secure">${icon('info')} No production signing service</span></header>`;
+}
+function gate({ eyebrow = 'Document access', title, message, tone = 'warning', actions = '', detail = '' }) {
+  return `${header()}<main class="signing-layout" id="main-content" tabindex="-1"><article class="document" style="min-height:420px"><div class="document__head"><div class="document__brand">MAHI TECH GROUP</div><h1>${escapeHTML(title)}</h1><div class="document__meta">${escapeHTML(eyebrow)}</div></div>${notice(escapeHTML(message), tone, '', tone === 'danger' ? 'lock' : 'info')}${detail ? `<dl class="definition-list mt-3">${detail}</dl>` : ''}<div class="form-actions mt-3">${actions}</div></article><aside class="signing-sidebar"><section class="signing-status"><span class="eyebrow">Authenticated signing contract</span><h2>Identity, token, decision.</h2><p>The production contract requires an authenticated signatory, a valid signature token, and an explicit agreed boolean. This demo enforces those interface states with local mock records only.</p></section><section class="signing-status"><span class="eyebrow">No legal effect</span><p>No identity verification, IP capture, legal execution, server audit, or secure token validation occurs in this frontend.</p></section></aside></main>`;
+}
+function documentView(context, signature, user, params) {
+  const { type, dispute, document, staticDocument } = context;
+  const title = staticDocument?.title || `${dispute.title} — ${type === 'agreement' ? 'Agreement' : 'Liability Waiver'}`;
+  const number = staticDocument?.number || `${dispute.number} / ${document.id}${document.version ? ` / VERSION ${document.version}` : ''}`;
+  const paragraphs = staticDocument?.paragraphs || String(document.text || '').split(/\n{2,}|\n/).filter(Boolean);
+  const clauses = staticDocument?.clauses || ['Review the complete displayed document before recording a decision.', 'Confirm that the authenticated demo identity matches the intended signatory.', 'Choose either accept or decline explicitly; no decision is inferred.', 'This browser-only demonstration has no legal effect.'];
+  const complete = ['signed', 'declined'].includes(signature.status);
