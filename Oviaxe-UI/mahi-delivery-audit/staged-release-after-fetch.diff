+}
+
+.nav-shell {
+  position: relative;
+  z-index: 2;
+  height: 78px;
+  display: flex;
+  align-items: center;
+}
+
+.desktop-nav {
+  display: flex;
+  align-items: stretch;
+  align-self: stretch;
+  gap: 0;
+  margin-left: auto;
+  margin-right: 32px;
