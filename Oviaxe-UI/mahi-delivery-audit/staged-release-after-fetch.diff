+}
+
+.desktop-nav a span {
+  align-self: flex-start;
+  margin-top: 19px;
+  color: var(--cobalt);
+  font-size: 7px;
+  font-weight: 800;
+}
+
+.desktop-nav a::after {
+  content: '';
+  position: absolute;
+  right: 18px;
+  bottom: 12px;
+  left: 18px;
+  height: 3px;
+  background: var(--cobalt);
+  transform: scaleX(0);
+  transform-origin: left;
+  transition: transform 180ms ease;
+}
+
+.desktop-nav a:hover,
+.desktop-nav a.is-active {
+  background: var(--paper);
+  color: var(--cobalt);
+}
+
+.desktop-nav a.is-active::after {
