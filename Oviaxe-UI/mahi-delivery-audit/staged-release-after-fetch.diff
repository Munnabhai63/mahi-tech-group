+}
+
+.text-link .icon {
+  font-size: 17px;
+}
+
+.text-link--lime {
+  color: var(--lime);
+}
+
+.text-link--lime:hover {
+  color: var(--paper);
+}
+
+.editorial-label {
+  display: inline-block;
+  border-left: 5px solid var(--cobalt);
+  padding-left: 10px;
+  font-size: 9px;
+  font-weight: 800;
+  letter-spacing: 0.13em;
+  line-height: 1.5;
+}
+
+.section-index {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 30px;
+  padding-top: 12px;
+  border-top: 2px solid currentColor;
+  font-size: 9px;
+  font-weight: 800;
+  letter-spacing: 0.13em;
+  line-height: 1.5;
+}
+
+/* Navigation */
+.site-header {
+  position: sticky;
+  top: 0;
+  z-index: 200;
+  height: 80px;
+  border-bottom: 2px solid var(--ink);
+  background: var(--ivory);
+}
+
+.scroll-progress {
