+}
+
+.menu-toggle {
+  display: none;
+  min-width: 86px;
+  height: 44px;
+  align-items: center;
+  justify-content: space-between;
+  gap: 10px;
+  margin-left: auto;
+  padding: 0 12px;
+  border: 2px solid var(--ink);
+  border-radius: 0;
+  background: var(--lime);
