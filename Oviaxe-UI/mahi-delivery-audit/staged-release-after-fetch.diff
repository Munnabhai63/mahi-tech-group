+.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);min-width:0}.card--pad{padding:22px}.card--flush{overflow:hidden}.card--dark{background:var(--sidebar);color:var(--sidebar-text);border-color:var(--sidebar)}.card--cobalt{background:var(--cobalt);color:#fff;border-color:var(--cobalt)}
