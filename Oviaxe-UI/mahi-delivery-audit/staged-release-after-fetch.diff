+}
+
+.menu-toggle .icon {
+  font-size: 19px;
+}
+
+.menu-toggle .close-icon {
+  display: none;
+}
+
+.menu-toggle[aria-expanded='true'] .menu-icon {
+  display: none;
+}
+
+.menu-toggle[aria-expanded='true'] .close-icon {
+  display: block;
+}
+
+.mobile-nav {
+  position: fixed;
+  top: 80px;
+  right: 0;
+  bottom: 0;
+  left: 0;
+  z-index: 1;
+  display: flex;
+  flex-direction: column;
+  padding: 26px 32px 28px;
+  background: var(--cobalt);
+  color: var(--paper);
+  opacity: 0;
+  visibility: hidden;
+  clip-path: inset(0 0 0 100%);
+  transition: clip-path 450ms var(--ease-editorial), opacity 250ms ease, visibility 0s 450ms;
+  overflow-y: auto;
+}
+
+body.menu-open .mobile-nav {
+  opacity: 1;
+  visibility: visible;
+  clip-path: inset(0 0 0 0);
+  transition-delay: 0s;
+}
+
+.mobile-nav__masthead,
+.mobile-nav__footer {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 20px;
+  font-size: 8px;
+  font-weight: 800;
+  letter-spacing: 0.13em;
+}
+
+.mobile-nav__masthead {
+  padding-bottom: 14px;
+  border-bottom: 1px solid rgba(248, 244, 234, 0.5);
+}
+
+.mobile-nav__links {
+  margin-block: auto;
+  padding-block: 24px;
+}
+
+.mobile-nav__links a {
+  display: grid;
+  grid-template-columns: 42px 1fr auto;
+  align-items: center;
+  min-height: 84px;
+  border-bottom: 1px solid rgba(248, 244, 234, 0.5);
+  font-family: var(--font-display);
+  font-size: clamp(30px, 7vw, 52px);
+  font-weight: 750;
+  letter-spacing: -0.05em;
+  line-height: 1;
+}
+
+.mobile-nav__links a > span {
+  align-self: start;
+  margin-top: 25px;
+  color: var(--lime);
+  font-family: var(--font-body);
+  font-size: 9px;
+  letter-spacing: 0;
+}
+
+.mobile-nav__links a .icon {
+  color: var(--lime);
+  font-size: 26px;
+  transition: transform 180ms ease;
+}
+
+.mobile-nav__links a:hover .icon {
+  transform: translate(4px, -4px);
+}
+
+.mobile-nav__footer {
+  align-items: flex-end;
+  padding-top: 16px;
+  border-top: 1px solid rgba(248, 244, 234, 0.5);
+  letter-spacing: 0;
+  text-transform: none;
+}
+
+.mobile-nav__footer a {
+  color: var(--lime);
+  font-size: 11px;
+  font-weight: 700;
+}
+
+/* Hero */
+.hero {
+  padding: 26px 0 64px;
+  overflow: hidden;
+}
+
+.hero__topline {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 24px;
+  padding-bottom: 12px;
+  border-bottom: 1px solid var(--ink);
+  font-size: 8.5px;
+  font-weight: 800;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+}
+
+.hero__topline span:nth-child(2) {
+  color: var(--cobalt);
+}
+
+.hero__composition {
+  --pointer-x: 0px;
+  --pointer-y: 0px;
+  position: relative;
+  min-height: 820px;
+  padding-top: 34px;
+}
+
+.hero h1 {
+  position: relative;
+  z-index: 2;
+  font-family: var(--font-display);
+  font-weight: 800;
+  text-transform: uppercase;
+  pointer-events: none;
+}
+
+.hero__line {
+  display: block;
+  overflow: hidden;
+  line-height: 0.77;
+}
+
+.hero__line > span {
+  display: block;
+  transform-origin: left bottom;
+}
+
+.hero__line--build,
+.hero__line--skills {
+  font-size: clamp(110px, 13vw, 190px);
+  letter-spacing: -0.075em;
+}
+
+.hero__line--skills {
+  margin-left: 7.5%;
+  color: var(--cobalt);
+}
+
+.hero__line--skills i {
+  display: inline-block;
+  margin-left: 0.04em;
+  color: var(--ink);
+  font-family: var(--font-serif);
+  font-size: 0.6em;
+  font-style: italic;
+  font-weight: 400;
+}
+
+.hero__line--move {
+  position: relative;
+  z-index: 3;
+  margin-top: 11px;
+  padding-right: 3%;
+  font-family: var(--font-serif);
+  font-size: clamp(58px, 7vw, 98px);
+  font-style: italic;
+  font-weight: 400;
+  letter-spacing: -0.04em;
+  line-height: 0.88;
+  text-align: right;
+  text-transform: none;
+}
+
+.hero__line--move > span {
+  display: inline-block;
+  padding: 0 13px 8px;
+  background: var(--ivory);
+}
+
+.hero__line--ideas {
+  margin-top: 5px;
+  margin-left: 1%;
+  font-size: clamp(82px, 9.5vw, 140px);
+  letter-spacing: -0.07em;
+  word-spacing: 0.09em;
+}
+
+.hero__line--forward {
+  margin-top: 6px;
+  color: var(--cobalt);
+  font-size: clamp(108px, 12.5vw, 185px);
+  letter-spacing: -0.08em;
+}
+
+.hero__media {
+  position: absolute;
+  top: 95px;
+  right: 0;
+  z-index: 1;
+  width: 31%;
+}
+
+.hero__image-wrap {
+  position: relative;
+  aspect-ratio: 0.805;
+  border: 2px solid var(--ink);
+  background: var(--cobalt);
+  box-shadow: 12px 12px 0 var(--cobalt);
+  clip-path: polygon(0 0, 100% 0, 100% 91%, 87% 100%, 0 100%);
+  overflow: visible;
+}
+
+.hero__image-wrap::after {
+  content: '';
+  position: absolute;
+  inset: 0;
+  border: 10px solid rgba(243, 239, 229, 0.18);
+  clip-path: polygon(0 0, 100% 0, 100% 91%, 87% 100%, 0 100%);
+  pointer-events: none;
+}
+
+.hero__image-wrap img {
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+  object-position: 50% 50%;
+  clip-path: polygon(0 0, 100% 0, 100% 91%, 87% 100%, 0 100%);
+  filter: saturate(0.76) contrast(1.06);
+  transform: scale(1.045) translate(var(--pointer-x), var(--pointer-y));
+  transition: transform 260ms ease-out, filter 300ms ease;
+}
+
+.hero__media:hover img {
+  filter: saturate(1) contrast(1.03);
+}
+
+.hero__image-index {
+  position: absolute;
+  right: -16px;
+  bottom: -22px;
+  z-index: 2;
+  padding: 0 7px;
+  border: 2px solid var(--ink);
+  background: var(--ivory);
+  font-family: var(--font-display);
+  font-size: 72px;
+  font-weight: 800;
+  letter-spacing: -0.08em;
+  line-height: 1;
+}
+
+.hero__image-tape {
+  position: absolute;
+  top: 58px;
+  left: -34px;
+  z-index: 2;
+  padding: 11px 8px;
+  border: 2px solid var(--ink);
+  background: var(--lime);
+  font-size: 8px;
+  font-weight: 800;
+  letter-spacing: 0.12em;
+  line-height: 1;
+  writing-mode: vertical-rl;
+  transform: rotate(180deg);
+}
+
+.hero__media figcaption,
+.mentorship__media figcaption {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 18px;
+  margin-top: 19px;
+  padding-top: 9px;
+  border-top: 1px solid var(--ink);
+  font-size: 7.5px;
+  font-weight: 800;
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+}
+
+.hero__annotation {
+  position: absolute;
+  top: 487px;
+  right: 34%;
+  z-index: 4;
+  width: 155px;
+  font-family: var(--font-serif);
+  font-size: 26px;
+  line-height: 0.95;
+  transform: rotate(-7deg);
+}
+
+.hero__annotation svg {
+  width: 90px;
+  margin-bottom: -5px;
+  fill: none;
+  stroke: var(--ink);
+  stroke-width: 1.7;
+}
+
+.hero__annotation em {
+  color: var(--cobalt);
+}
+
+.hero__intro {
+  position: absolute;
+  right: 0;
+  bottom: 46px;
+  z-index: 5;
+  width: 33%;
+  padding: 18px 0 0 28px;
+  border-top: 2px solid var(--ink);
+  background: var(--ivory);
+}
+
+.hero__lead {
+  max-width: 410px;
+  margin-top: 14px;
+  color: var(--muted);
+  font-size: 14px;
+  line-height: 1.75;
+}
+
+.hero__actions {
+  display: flex;
+  align-items: flex-start;
+  flex-direction: column;
+  gap: 21px;
+  margin-top: 23px;
+}
+
+.hero__checks {
+  position: absolute;
+  bottom: 49px;
+  left: 0;
+  z-index: 3;
+  display: flex;
+  gap: 38px;
+  list-style: none;
+}
+
+.hero__checks li {
+  min-width: 170px;
+  padding-top: 9px;
+  border-top: 2px solid var(--ink);
+}
+
+.hero__checks li > span {
+  display: block;
+  color: var(--cobalt);
+  font-size: 8px;
+  font-weight: 800;
+}
+
+.hero__checks strong {
+  display: block;
+  margin-top: 3px;
+  font-size: 11px;
+  font-weight: 800;
+}
+
+.js .hero__line > span {
+  opacity: 0;
+  transform: translateY(112%);
+  animation: hero-line-in 900ms var(--ease-editorial) forwards;
+}
+
+.js .hero__line--skills > span { animation-delay: 90ms; }
+.js .hero__line--move > span { animation-delay: 180ms; }
+.js .hero__line--ideas > span { animation-delay: 270ms; }
+.js .hero__line--forward > span { animation-delay: 360ms; }
+
+.js .hero__media {
+  opacity: 0;
+  clip-path: inset(0 100% 0 0);
+  animation: hero-media-in 1050ms 320ms var(--ease-editorial) forwards;
+}
+
+.js .hero__intro,
+.js .hero__checks,
+.js .hero__annotation {
+  opacity: 0;
+  animation: hero-detail-in 650ms 850ms ease forwards;
+}
+
+@keyframes hero-line-in {
+  to { opacity: 1; transform: translateY(0); }
+}
+
+@keyframes hero-media-in {
+  to { opacity: 1; clip-path: inset(0 0 0 0); }
+}
+
+@keyframes hero-detail-in {
+  from { opacity: 0; translate: 0 15px; }
+  to { opacity: 1; translate: 0 0; }
+}
+
+/* Audience */
+.audience-strip {
+  border-block: 2px solid var(--ink);
+  background: var(--ink);
+  color: var(--paper);
+}
+
+.audience-strip__inner {
+  min-height: 88px;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 32px;
+}
+
+.audience-strip__label {
+  color: var(--lime);
+  font-family: var(--font-serif);
+  font-size: 20px;
+  font-style: italic;
+}
+
+.audience-strip ul {
+  display: flex;
+  align-items: center;
+  gap: 34px;
+  list-style: none;
+}
+
+.audience-strip li {
+  display: flex;
+  align-items: center;
+  gap: 9px;
+  font-size: 10px;
+  font-weight: 750;
+  letter-spacing: 0.04em;
+  text-transform: uppercase;
+}
+
+.audience-strip li > span {
+  color: var(--lime);
+  font-family: var(--font-display);
+  font-size: 21px;
+  line-height: 1;
+}
+
+/* Learning tracks */
+.learning {
+  padding: 88px 0 70px;
+  background: var(--ink);
+  color: var(--paper);
+}
+
+.learning .section-index {
+  color: var(--paper-muted);
+}
+
+.learning__header {
+  display: grid;
+  grid-template-columns: 8fr 4fr;
+  align-items: end;
+  gap: 60px;
+  margin-top: 45px;
+}
+
+.learning__header h2 {
+  max-width: 940px;
+  font-family: var(--font-display);
+  font-size: clamp(54px, 6.3vw, 88px);
+  font-weight: 750;
+  letter-spacing: -0.065em;
+  line-height: 0.92;
+}
+
+.learning__header h2 > span {
+  display: block;
+  margin-bottom: 12px;
+  color: var(--lime);
+  font-family: var(--font-serif);
+  font-size: 0.68em;
+  font-style: italic;
+  font-weight: 400;
+  letter-spacing: -0.035em;
+}
+
+.learning__header h2 em {
+  color: var(--lime);
+  font-family: var(--font-serif);
+  font-weight: 400;
+}
+
+.learning__header > p {
+  max-width: 390px;
+  padding-bottom: 5px;
+  color: var(--paper-muted);
+  font-size: 13px;
+  line-height: 1.8;
+}
+
+.track-list {
+  margin-top: 62px;
+}
+
+.track-row {
+  --track-accent: var(--cobalt);
+  --track-on-accent: var(--paper);
+  --track-pop: var(--lime);
+  --track-muted: var(--paper-muted);
+  position: relative;
+  display: grid;
+  grid-template-columns: 82px minmax(0, 1fr) 205px 115px;
+  align-items: center;
+  min-height: 220px;
+  border-top: 1px solid #51514a;
+  color: var(--paper);
+  transition: background 280ms ease, color 280ms ease;
+  isolation: isolate;
+}
+
+.track-row:last-child {
+  border-bottom: 1px solid #51514a;
+}
+
+.track-row--cobalt {
+  --track-accent: var(--cobalt);
+  --track-on-accent: var(--paper);
+  --track-pop: var(--lime);
+}
+
+.track-row--lime {
+  --track-accent: var(--lime);
+  --track-on-accent: var(--ink);
+  --track-pop: var(--lime);
+}
+
+.track-row--paper {
+  --track-accent: var(--paper);
+  --track-on-accent: var(--ink);
+  --track-pop: var(--cobalt-light);
+}
+
+.track-row--graphite {
+  --track-accent: #292924;
+  --track-on-accent: var(--paper);
+  --track-pop: var(--lime);
+}
+
+.track-row:hover,
+.track-row:focus-within {
+  --track-muted: var(--track-on-accent);
+  background: var(--track-accent);
+  color: var(--track-on-accent);
+}
+
+.track-row--lime:hover,
+.track-row--lime:focus-within {
+  --track-pop: var(--cobalt);
+}
+
+.track-row--paper:hover,
+.track-row--paper:focus-within {
+  --track-pop: var(--cobalt);
+}
+
+.track-row__hit {
+  position: absolute;
+  inset: 0;
+  z-index: 5;
+  padding: 0;
+  border: 0;
+  background: transparent;
+  cursor: pointer;
+}
+
+.track-row__hit:focus-visible {
+  outline: 3px solid var(--lime);
+  outline-offset: -5px;
+}
+
+.track-row--lime .track-row__hit:focus-visible,
+.track-row--paper .track-row__hit:focus-visible {
+  outline-color: var(--cobalt);
+}
+
+.track-row__number {
+  align-self: start;
+  padding-top: 38px;
+  color: var(--track-pop);
+  font-family: var(--font-display);
+  font-size: 25px;
+  font-weight: 700;
+  letter-spacing: -0.05em;
+  transition: transform 280ms var(--ease-editorial);
