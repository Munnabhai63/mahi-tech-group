# MAHI TECH GROUP — LOCAL ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env for local development:
# cp .env.example .env
#
# IMPORTANT: Never commit your actual .env file or production secrets to Git.

PORT=4000
JWT_SECRET=local-dev-jwt-secret-key-change-in-production-2026
JWT_EXPIRES_IN=7d
DB_PATH=./database.sqlite
BCRYPT_SALT_ROUNDS=12
ENCRYPTION_KEY=local-dev-aes-256-gcm-master-key-must-be-32-bytes!

# Optional AI Integration (Whisper / GPT-4o notes)
# Leave blank to use fallback local summarizer
OPENAI_API_KEY=
