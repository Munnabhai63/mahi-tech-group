# MAHI TECH GROUP — LOCAL ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env for local development:
# cp .env.example .env
#
# IMPORTANT: Never commit your actual .env file or production secrets to Git.
# In production (NODE_ENV=production) the server REFUSES to start unless
# JWT_SECRET and ENCRYPTION_KEY are provided (min 16 characters each).

# --- Core server ---
PORT=4000
DB_PATH=./database.sqlite
# Set true only behind a reverse proxy (so req.ip resolves from X-Forwarded-For)
TRUST_PROXY=false
# Comma-separated list of allowed cross-origin URLs. Empty = same-origin only.
CORS_ORIGIN=

# --- Secrets (REQUIRED in production; dev falls back to ephemeral random keys) ---
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
ENCRYPTION_KEY=

# --- First admin account (required when seeding in production) ---
ADMIN_EMAIL=admin@mahitechgroup.com
ADMIN_PASSWORD=

# --- AI meeting notes (Whisper + GPT-4o) ---
# Leave blank to generate clearly-labelled placeholder drafts (no API calls).
# Note: Whisper caps files at 25MB — larger uploads are rejected at the door.
OPENAI_API_KEY=

# --- Transactional email (SMTP via nodemailer) ---
# Leave blank to use the local audit fallback (emails are logged, NOT sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@mahitechgroup.com
